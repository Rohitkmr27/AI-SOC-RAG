# Application settings for the backend.
# Copy this file to .env and set values in your shell or deployment environment.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL database connection URL
DATABASE_URL=postgresql+psycopg://ai_soc_user:change_me@localhost:5432/ai_soc_rag

# JWT Authentication Configuration (Stage 10)
# Generate a secure 32-byte secret key in production (e.g. using `openssl rand -hex 32`)
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-secret-key-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Security Hardening: Allowed CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Initial Local Admin User Initialization (`python -m app.auth.init_admin`)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@aisoc.local
ADMIN_PASSWORD=replace-with-a-secure-admin-password

# Google Gemini API configuration for Stage 5 RAG generation.
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash
